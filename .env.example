# Copy this file to .env and fill in real values for local development.

# Local Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://tailgate:tailgate@localhost:5432/tailgate

# Password required to add/delete attendees from the Add Attendee page and API.
# Pick your own value — this is NOT your USC or personal password.
ADMIN_PASSWORD=changeme

# Port the Express server listens on locally (Render sets its own PORT automatically)
PORT=3001
