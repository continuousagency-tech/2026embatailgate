# Copy this file to .env and fill in real values for local development.

# Local Postgres connection (matches docker-compose.yml defaults), or point
# this at your Render database's External Database URL to develop against
# production data.
DATABASE_URL=postgresql://tailgate:tailgate@localhost:5432/tailgate

# Password required to add/edit/remove attendees and upload photos via
# /admin.html and the API. Pick your own value.
ADMIN_PASSWORD=changeme

# Cloudinary connection string, used by /admin.html's photo upload feature.
# Find this exact string on your Cloudinary dashboard under
# "API Environment variable" (Settings -> API Keys). Format:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Port the Express server listens on locally (Render sets its own PORT automatically)
PORT=3001
